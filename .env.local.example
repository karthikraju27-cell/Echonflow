# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase project settings -> API -> service_role key (secret — never expose
# client-side). Used server-only, for looking up a provider's email to
# notify them of a lead, and by the daily re-audit nudge cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (resend.com) -> API Keys
RESEND_API_KEY=your-resend-api-key
# Must be an address on a domain you've verified in Resend. Format:
# "Echonflow <notifications@echonflow.com>"
EMAIL_FROM="Echonflow <notifications@echonflow.com>"

# Any random string — set the same value here and in Vercel's env vars.
# Protects the /api/cron/re-audit-nudge endpoint from being called by
# anyone who isn't Vercel's own cron scheduler.
CRON_SECRET=generate-a-random-string

# Any random string — set the same value here and in Vercel's env vars.
# Gates /admin/reports/[slug] (?key=...), the pilot cohort aggregate
# report. Personal-use gate, not a real admin system — keep this private.
ADMIN_REPORT_SECRET=generate-a-random-string

# Comma-separated email addresses allowed to sign in to the private CRM.
# These must already be real Supabase Auth accounts. Server-only setting.
ADMIN_EMAILS=karthikraju27@gmail.com
